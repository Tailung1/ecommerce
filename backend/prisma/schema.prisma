generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  email     String?  @unique @db.VarChar(255)
  password  String?  @db.VarChar(255)

  @@map("users")
}

model PasswordResetSession {
  id        String   @id @default(uuid())
  userId    Int      @map("user_id")
  otpHash   String   @map("otp_hash")
  status    String // PENDING | VERIFIED | USED | EXPIRED
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_reset_sessions")
}

model Product {
  id               Int               @id @default(autoincrement())
  name             String            @db.VarChar(255)
  description      String?
  price            Decimal           @db.Decimal(10, 2)
  stock            Int               @default(0)
  imageUrl         String?           @map("image_url")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at")
  categoryProducts CategoryProduct[]
 images  ProductImage[]

  @@map("products")
}

model Category {
  id               Int               @id @default(autoincrement())
  name             String
  slug             String            @unique
  categoryProducts CategoryProduct[]

  @@map("categories")
}

model CategoryProduct {
  id         Int @id @default(autoincrement())
  productId  Int @map("product_id")
  categoryId Int @map("category_id")

  category Category @relation(fields: [categoryId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@map("category_product")
}

model HomePageSection {
    id  Int @id @default(autoincrement())
    type String
    title String?
    position Int
    enabled Boolean
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("home_page_sections")
}

model ProductCarouselConfig {
    id Int @id @default(autoincrement())
    sectionId Int @unique @map("section_id")
    section HomePageSection @relation(fields:[sectionId],references:[id])
    categoryId Int?
    limit Int @default(10)

  @@map("product_carousel_config")
}

model sectionProduct {
    id Int @id @default(autoincrement())
    sectionId Int @map("section_id")
    productId Int  @map("product_id")
    position Int

 section HomepageSection @relation(
   fields:[sectionId],
   references:[id]
 )

 product Product @relation(
   fields:[productId],
   references:[id]
 )

 @unique([sectionId,productId])

  @@map("section_products")

}

model ProductImage {
    id  Int @id @default(autoincrement())
    productId Int  @map("product_id")
    product Product @relation(fields:[productId],references:[id])
    position Int
url String
   @@map("product_images")

}