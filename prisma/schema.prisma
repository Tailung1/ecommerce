generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model products {
  id         Int      @id(map: "untitled_table_pkey") @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamp(6)
  name       String?  @db.VarChar(255)
  price      Int?
  stock      Int?
}
